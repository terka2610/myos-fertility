modules = ["nodejs-22", "python-3.11"]
# Web app (8080) + Seidu's GPS monitor (8787) + cryo API and simulated chat (8790).
run = "npm run dev:all"

[nix]
channel = "stable-24_05"

# MYOS web app
[[ports]]
localPort = 8080
externalPort = 80

# Courier GPS monitor map (/), live feed (/api/latest)
[[ports]]
localPort = 8787
externalPort = 3000

# Cryo sample API (/api/samples/SMP-0001) and simulated chat (/chat)
[[ports]]
localPort = 8790
externalPort = 3001

[deployment]
run = ["sh", "-c", "npm run dev:all"]
deploymentTarget = "cloudrun"
