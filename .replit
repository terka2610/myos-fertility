modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "scene-performance"

[[workflows.workflow]]
name = "scene-performance"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/myos-fertility run test:scene-budgets && pnpm --filter @workspace/myos-fertility run test:scene-performance"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
GROQ_MODEL = "openai/gpt-oss-120b"
LINQ_DOCTOR_ID = "d0c70000-0000-4000-8000-000000000004"
SUPABASE_PROJECT_ID = "krlhagsprstqiwzmfpsh"
SUPABASE_URL = "https://krlhagsprstqiwzmfpsh.supabase.co"
VITE_SUPABASE_PROJECT_ID = "krlhagsprstqiwzmfpsh"
VITE_SUPABASE_URL = "https://krlhagsprstqiwzmfpsh.supabase.co"
